{
  "name": "dsh-textbook-reader",
  "version": "0.4.0",
  "description": "教材伴读 (Textbook Reader) for DeepSeek Harness: MinerU-parsed PDF textbook library, auto chapter tree, page-anchored citations with a built-in pdf.js reader, and cross-session learning progress.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "dist",
    "lib",
    "reader",
    "presets",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.reader.json --noEmit",
    "pretest": "pnpm run build",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "dev:reader": "node scripts/dev-server.mjs",
    "seed:demo": "node scripts/seed-m2-demo.mjs",
    "probe:mineru": "node scripts/mineru-probe.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pdf",
    "textbook",
    "mineru",
    "pdfjs"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@types/node": "^22.20.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "esbuild": "^0.28.2",
    "pdfjs-dist": "6.4.299",
    "playwright-core": "1.64.1",
    "typescript": "~5.9.3",
    "yazl": "^3.3.1"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "yauzl": "3.4.0"
  }
}
